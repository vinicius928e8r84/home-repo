  "ferramentas": [
    {
      "nome": "ruff",
      "quando_existe": [
        "scripts/freios/ruff.toml"
      ],
      "comando": [
        "ruff",
        "check",
        "--no-cache",
        "--config",
        "scripts/freios/ruff.toml"
      ],
      "alvo_tudo": [
        "."
      ],
      "extensoes": [
        ".py"
      ]
    },
    {
      "nome": "eslint",
      "quando_existe": [
        "scripts/freios/eslint.config.mjs"
      ],
      "comando": [
        "npx",
        "--prefix",
        "scripts/freios",
        "eslint",
        "--config",
        "scripts/freios/eslint.config.mjs"
      ],
      "alvo_tudo": [
        ".pi",
        "scripts"
      ],
      "extensoes": [
        ".ts",
        ".mts",
        ".js",
        ".mjs",
        ".cjs"
      ]
